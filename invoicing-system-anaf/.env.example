# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=invoicing_anaf
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ANAF Configuration
ANAF_BASE_URL=https://webservicesp.anaf.ro
ANAF_OAUTH_URL=https://oauth.anaf.gov.ro
ANAF_CLIENT_ID=your-anaf-client-id
ANAF_CLIENT_SECRET=your-anaf-client-secret

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
